---
import badge from "./badge.astro";

interface Props{
  img: string;
  img_alt: string;
  href: string;
  post_cl: string;
  tags: string[];
}

const {
    img = "/default.webp",
    img_alt = "default_alt",
    href = "",
    post_cl = "",
    tags = [],
} = Astro.props;
---

<div id="card-img-up" class={post_cl}>
    <a href={href}>
        <div class="img">
            <img src={img} alt={img_alt} loading="lazy" />
        </div>
        <div class="txt">
            <span class="date"><slot name="date">01-01-2000</slot></span>
            <h3><slot name="header">Default header</slot></h3>
            <p>
                <slot name="text"
                    >Lorem ipsum dolor sit amet consectetur, adipisicing elit.</slot>
            </p>
            <div class="tags">
                {tags.map((tag) => <badge name={tag} />)}
                
            </div>
        </div>
    </a>
</div>

<style>
    #card-img-up {
        width: 100%;
        height: 100%;
        background-color: var(--bg-color);

        .img {
            height: 65%;
            overflow: hidden;
            img {
                height: 100%;
                width: 100%;
                object-fit: cover;
            }
        }

        .txt {
            margin: 0 1rem;
            h3 {
                margin: 1.2rem 0 0.7rem;
                font-size: 2.2rem;
            }

            .date {
                float: right;
                color: var(--txt-sub-color);
            }

            .tags {
                margin-top: 1rem;
            }
        }

        &:hover {
            transform: scale(1.02);
        }
    }

    .sub {
        font-size: 0.8rem !important;
        h3 {
            font-size: 1.5rem !important;
            margin: 0.9rem 0 0.5rem !important;
        }
        .tags {
            margin-top: 0.5rem !important;
        }
    }
</style>