---
import badge from "./badge.astro";

interface Props{
  href: string;
  post_cl: string;
  tags: string[];
  author: string;
}

const {
    href = "",
    post_cl = "",
    tags = [],
    author = "",
} = Astro.props;
---

<div id="card-img-up" class={post_cl}>
    <a href={href}>
        <div class="txt">
            <span class="date"><slot name="date">01-01-2000</slot></span>
            <span class="author"> <slot name="author">Admin</slot> </span>
            <h3><slot name="header">Default header</slot></h3>
            <p>
                <slot name="text"
                    >Lorem ipsum dolor sit amet consectetur, adipisicing elit.</slot>
            </p>
            <div class="tags">
                {tags.map((tag) => <badge name={tag} />)}
                
            </div>
        </div>
    </a>
</div>

<style>
    #card-img-up {
        width: 100%;
        height: 100%;
        background-color: var(--bg-color);
        padding: 10px 15px 20px;
        border-radius: 2rem;
        border: 1px solid var(--txt-sub-color);

        .img {
            height: 65%;
            overflow: hidden;
            img {
                height: 100%;
                width: 100%;
                object-fit: cover;
            }
        }

        .txt {
            margin: 0 1rem;
            .author{
                margin-top: 1.4rem;
                color: var(--txt-sub-color);
            }
            h3 {
                margin: .6rem 0 0.7rem;
                font-size: 1.6rem;
            }

            .date {
                float: right;
                color: var(--txt-sub-color);
            }

            .tags {
                margin-top: 1rem;

                & > *{
                    margin: 0.5rem 0 0;
                    font-size: 0.8rem;
                }
            }
        }

        &:hover {
            transform: scale(1.02);
        }

        animation-name: anim3;
        animation-duration: 2s;
        animation-fill-mode: backwards;
    }

    .sub {
        font-size: 0.8rem !important;
        h3 {
            font-size: 1.5rem !important;
            margin: 0.9rem 0 0.5rem !important;
        }
        .tags {
            margin-top: 0.5rem !important;
        }
    }

    @keyframes anim3{
        from{
            opacity: 0;
            transform: translateY(-.5rem);
        }
        to{
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>